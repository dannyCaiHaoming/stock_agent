{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-handoff/2.0.0",
  "title": "PortfolioHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "draft_id", "draft_hash", "advisory_only",
    "confirmation", "portfolio_scope", "research_scope", "source_items", "portfolio",
    "council_readiness", "capability_gaps", "portfolio_hash", "research_plan", "handoff_hash"
  ],
  "properties": {
    "schema_version": {"const": "portfolio-handoff/2.0.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "draft_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "advisory_only": {"const": true},
    "confirmation": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "confirmed_at", "draft_hash"],
      "properties": {
        "confirmed": {"const": true},
        "confirmed_at": {"type": "string", "minLength": 1},
        "draft_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "portfolio_scope": {"type": "string", "enum": ["BROKER_ACCOUNT", "USER_DEFINED_PORTFOLIO"]},
    "research_scope": {"const": "ALL_INPUT_POSITIONS"},
    "council_readiness": {"type": "string", "enum": ["READY", "CAPABILITY_GAP"]},
    "capability_gaps": {
      "type": "array",
      "items": {"type": "string", "enum": ["company-research", "etf-research", "options-research"]},
      "uniqueItems": true
    },
    "source_items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_type", "as_of", "retrieved_at", "content_hash", "external_ref", "synthetic", "coverage_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "enum": ["SCREENSHOT", "MANUAL", "USER_CORRECTION"]},
          "as_of": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "external_ref": {"type": ["string", "null"]},
          "synthetic": {"type": "boolean"},
          "coverage_status": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]}
        }
      }
    },
    "portfolio": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "base_currency", "cash", "positions", "holding_horizon", "research_question", "benchmark_id", "mandate_artifact_id"],
      "properties": {
        "as_of": {"type": "string", "minLength": 1},
        "base_currency": {"type": "string", "const": "USD"},
        "cash": {"type": "number", "minimum": 0},
        "positions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["security_id", "ticker", "market", "asset_type", "quantity", "cost_basis", "option_contract", "required_capability", "source_refs"],
            "properties": {
              "security_id": {"type": "string", "minLength": 1},
              "ticker": {"type": "string", "minLength": 1},
              "market": {"const": "US"},
              "asset_type": {"type": "string", "enum": ["COMMON_STOCK", "ETF", "OPTION"]},
              "quantity": {"type": "number", "not": {"const": 0}},
              "cost_basis": {"type": ["number", "null"], "minimum": 0},
              "option_contract": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["underlying_ticker", "option_type", "expiration_date", "strike", "contract_multiplier", "contract_symbol"],
                    "properties": {
                      "underlying_ticker": {"type": "string", "minLength": 1},
                      "option_type": {"type": "string", "enum": ["CALL", "PUT"]},
                      "expiration_date": {"type": "string", "minLength": 1},
                      "strike": {"type": "number", "exclusiveMinimum": 0},
                      "contract_multiplier": {"type": "integer", "minimum": 1},
                      "contract_symbol": {"type": ["string", "null"]}
                    }
                  }
                ]
              },
              "required_capability": {"type": "string", "enum": ["company-research", "etf-research", "options-research"]},
              "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "allOf": [
              {
                "if": {"properties": {"asset_type": {"const": "OPTION"}}},
                "then": {"properties": {"option_contract": {"type": "object"}, "required_capability": {"const": "options-research"}}},
                "else": {"properties": {"option_contract": {"type": "null"}}}
              },
              {
                "if": {"properties": {"asset_type": {"const": "COMMON_STOCK"}}},
                "then": {"properties": {"required_capability": {"const": "company-research"}}}
              },
              {
                "if": {"properties": {"asset_type": {"const": "ETF"}}},
                "then": {"properties": {"required_capability": {"const": "etf-research"}}}
              }
            ]
          }
        },
        "holding_horizon": {"type": "string", "minLength": 1},
        "research_question": {"type": "string", "minLength": 1},
        "benchmark_id": {"type": "string", "minLength": 1},
        "mandate_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "portfolio_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "research_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "completed", "pending", "failed", "batch_size", "items"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "completed": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["security_id", "required_capability", "status", "batch_index"],
            "properties": {
              "security_id": {"type": "string", "minLength": 1},
              "required_capability": {"type": "string", "enum": ["company-research", "etf-research", "options-research"]},
              "status": {"type": "string", "enum": ["PENDING", "PENDING_CAPABILITY", "COMPLETED", "FAILED"]},
              "batch_index": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "handoff_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
