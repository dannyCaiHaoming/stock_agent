{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "council-research-plan/2.0.0",
  "title": "CouncilResearchPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planning_only",
    "request_id",
    "request_hash",
    "total",
    "pending",
    "batch_size",
    "coverage_status",
    "capability_status",
    "capability_gaps",
    "items",
    "agent_invocations",
    "llm_invocations",
    "plan_hash",
    "input_kind",
    "input_request_id",
    "input_request_hash",
    "input_artifact_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "council-research-plan/2.0.0"
    },
    "planning_only": {
      "$ref": "council-research-plan.schema.json#/properties/planning_only"
    },
    "request_id": {
      "$ref": "council-research-plan.schema.json#/properties/request_id"
    },
    "request_hash": {
      "$ref": "council-research-plan.schema.json#/properties/request_hash"
    },
    "total": {
      "$ref": "council-research-plan.schema.json#/properties/total"
    },
    "pending": {
      "$ref": "council-research-plan.schema.json#/properties/pending"
    },
    "batch_size": {
      "$ref": "council-research-plan.schema.json#/properties/batch_size"
    },
    "coverage_status": {
      "const": "SINGLE_COMMON_STOCK"
    },
    "capability_status": {
      "$ref": "council-research-plan.schema.json#/properties/capability_status"
    },
    "capability_gaps": {
      "$ref": "council-research-plan.schema.json#/properties/capability_gaps"
    },
    "items": {
      "$ref": "council-research-plan.schema.json#/properties/items"
    },
    "agent_invocations": {
      "$ref": "council-research-plan.schema.json#/properties/agent_invocations"
    },
    "llm_invocations": {
      "$ref": "council-research-plan.schema.json#/properties/llm_invocations"
    },
    "plan_hash": {
      "$ref": "council-research-plan.schema.json#/properties/plan_hash"
    },
    "input_kind": {
      "const": "SINGLE_STOCK_RESEARCH"
    },
    "input_request_id": {
      "type": "string",
      "minLength": 1
    },
    "input_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_artifact_ref": {
      "const": "audit/single-stock-request.json"
    }
  }
}
