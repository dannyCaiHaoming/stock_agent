{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "council-request/2.0.0",
  "title": "CouncilRequest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "request_id", "handoff_id", "handoff_hash",
    "portfolio_hash", "research_question", "holding_horizon", "research_scope",
    "research_security_ids", "benchmark_id", "mandate_artifact_id", "constraints",
    "request_hash"
  ],
  "properties": {
    "schema_version": {"const": "council-request/2.0.0"},
    "stage": {"enum": ["COMMON_STOCK_RESEARCH", "MULTI_DIMENSIONAL_HOLDING_RESEARCH", "INDEPENDENT_COUNTER_THESIS_RESEARCH", "FULL_COUNCIL"]},
    "request_id": {"type": "string", "minLength": 1},
    "handoff_id": {"type": "string", "minLength": 1},
    "handoff_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portfolio_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "research_question": {"type": "string", "minLength": 1},
    "holding_horizon": {"type": ["string", "null"], "minLength": 1},
    "research_scope": {"const": "ALL_INPUT_POSITIONS"},
    "research_security_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "benchmark_id": {"type": ["string", "null"], "minLength": 1},
    "mandate_artifact_id": {"type": ["string", "null"], "minLength": 1},
    "constraints": {"type": "object"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
