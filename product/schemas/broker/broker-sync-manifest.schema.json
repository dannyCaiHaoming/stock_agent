{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "broker-sync-manifest/1.0.0",
  "title": "BrokerSyncManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sync_id", "account_ref", "source_id", "as_of",
    "retrieved_at", "content_hash", "provider", "sdk_version",
    "history_start", "history_start_accuracy", "window_start", "window_end",
    "coverage_status", "category_counts", "windows", "duplicate_count",
    "revision_count", "gaps", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "broker-sync-manifest/1.0.0"},
    "sync_id": {"type": "string", "minLength": 1},
    "account_ref": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"const": "TIGER_TBHK"},
    "sdk_version": {"const": "3.8.0"},
    "history_start": {"type": "string", "minLength": 1},
    "history_start_accuracy": {"enum": ["EXACT", "APPROXIMATE"]},
    "window_start": {"type": "string", "minLength": 1},
    "window_end": {"type": "string", "minLength": 1},
    "coverage_status": {"enum": ["PARTIAL", "API_COMPLETE_WITHIN_DECLARED_WINDOW"]},
    "category_counts": {"type": "array", "items": {"$ref": "#/$defs/count"}},
    "windows": {"type": "array", "items": {"$ref": "#/$defs/window"}},
    "duplicate_count": {"type": "integer", "minimum": 0},
    "revision_count": {"type": "integer", "minimum": 0},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "count": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "count"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "start", "end", "status", "page_count", "record_count", "next_token_seen"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "status": {"enum": ["COMPLETE", "FAILED"]},
        "page_count": {"type": "integer", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 0},
        "next_token_seen": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "start", "end", "error_code", "retryable"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "error_code": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
