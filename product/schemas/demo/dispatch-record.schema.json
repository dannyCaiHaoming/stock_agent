{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/demo-dispatch-record/1.0.0",
  "type": "object",
  "required": ["schema_version", "run_id", "dispatch_id", "from", "to", "artifact_ref", "validation_status"],
  "properties": {
    "schema_version": {"const": "demo-dispatch-record/1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "from": {"enum": ["demo_orchestrator", "runtime_company_analyst", "runtime_skeptic", "runtime_cio"]},
    "to": {"enum": ["runtime_company_analyst", "runtime_skeptic", "runtime_cio", "deterministic_risk_engine"]},
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "validation_status": {"const": "VALIDATED"}
  },
  "additionalProperties": false
}
