{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/agent-package-demo-input/1.0.0",
  "type": "object",
  "required": [
    "schema_version", "profile", "synthetic", "advisory_only", "llm_used",
    "fixture_version", "fixture_id", "scenario_type", "run_id",
    "research_question", "decision_cutoff", "freshness_policy",
    "conflict_policy_version", "portfolio", "evidence", "role_samples",
    "domain_status_examples", "risk_veto_cio_sample"
  ],
  "properties": {
    "schema_version": {"const": "agent-package-demo-input/1.0.0"},
    "profile": {"const": "DEMO_SCAFFOLD"},
    "synthetic": {"const": true},
    "advisory_only": {"const": true},
    "llm_used": {"const": false},
    "fixture_version": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "scenario_type": {"const": "agent_package_demo"},
    "run_id": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "decision_cutoff": {"type": "string", "minLength": 1},
    "freshness_policy": {"type": "object"},
    "conflict_policy_version": {"type": "string", "minLength": 1},
    "portfolio": {"type": "object"},
    "evidence": {"type": "array", "minItems": 1},
    "role_samples": {
      "type": "object",
      "required": ["analyst", "skeptic", "cio"],
      "properties": {
        "analyst": {"type": "object"},
        "skeptic": {"type": "object"},
        "cio": {"type": "object"}
      },
      "additionalProperties": false
    },
    "domain_status_examples": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["COMPLETE", "INSUFFICIENT_EVIDENCE", "LOW_CONFIDENCE", "TIMEOUT"]}
    },
    "risk_veto_cio_sample": {"type": "object"}
  },
  "additionalProperties": false
}
