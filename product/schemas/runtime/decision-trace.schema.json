{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/decision-trace/2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "terminal_state",
    "runtime",
    "agents",
    "events",
    "risk_lineage",
    "artifacts",
    "codex_execution",
    "mcp_events",
    "evidence_lineage"
  ],
  "properties": {
    "schema_version": {"const": "decision-trace/2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "terminal_state": {"enum": ["COMPLETED", "SAFE_NO_TRADE", "FAILED_VALIDATION"]},
    "runtime": {"type": "object"},
    "agents": {"type": "array"},
    "events": {"type": "array"},
    "risk_lineage": {"type": "array"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "codex_execution": {"type": ["object", "null"]},
    "mcp_events": {"type": "array"},
    "evidence_lineage": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
