{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-research-snapshot/1.0.0",
  "title": "Non-holding research snapshot", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_mode", "input_kind", "research_request", "research_request_hash", "snapshot_id", "snapshot_hash", "request_started_at", "decision_cutoff", "source_access", "facts", "gaps", "collection_events", "raw_records", "freshness_policy_version", "universe", "source_selections"],
  "properties": {
    "schema_version": {"const": "live-research-snapshot/1.0.0"}, "source_mode": {"const": "live"},
    "input_kind": {"const": "SINGLE_STOCK_RESEARCH"}, "research_request": {"type": "object"},
    "research_request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_id": {"type": "string", "minLength": 1}, "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_started_at": {"type": "string", "format": "date-time"}, "decision_cutoff": {"type": "string", "format": "date-time"},
    "source_access": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "facts": {"type": "array", "items": {"type": "object"}}, "gaps": {"type": "array", "items": {"type": "string"}},
    "collection_events": {"type": "array", "items": {"type": "object"}}, "raw_records": {"type": "array", "items": {"type": "object"}},
    "freshness_policy_version": {"const": "live-freshness/1.0.0"}, "universe": {"type": "object"},
    "source_selections": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}
  }
}
