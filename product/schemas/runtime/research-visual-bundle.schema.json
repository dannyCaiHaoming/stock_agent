{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-visual-bundle/1.0.0",
  "title": "ResearchVisualBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "report_id", "run_id", "security_id", "decision_cutoff", "charts", "bundle_hash"],
  "properties": {
    "schema_version": {"const": "research-visual-bundle/1.0.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "charts": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/chart"}},
    "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart_data_version", "chart_id", "title", "unit", "status", "basis", "window", "limitations", "evidence_refs", "calculation_refs", "data", "data_hash"],
      "properties": {
        "chart_data_version": {"const": "research-chart-data/1.0.0"},
        "chart_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "status": {"enum": ["AVAILABLE", "LIMITED"]},
        "basis": {"type": ["string", "null"]},
        "window": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "calculation_refs": {"type": "array", "items": {"type": "string"}},
        "data": {"type": "array", "items": {"type": "object"}},
        "data_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
