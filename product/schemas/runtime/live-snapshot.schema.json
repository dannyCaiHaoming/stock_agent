{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_mode",
    "snapshot_id",
    "snapshot_hash",
    "request_started_at",
    "decision_cutoff",
    "portfolio_hash",
    "source_access",
    "facts",
    "gaps",
    "collection_events",
    "raw_records",
    "identity",
    "freshness_policy_version"
  ],
  "properties": {
    "identity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "binding",
        "sec_mapping",
        "security_metadata"
      ],
      "properties": {
        "binding": {
          "type": "object"
        },
        "sec_mapping": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "security_metadata": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "const": "live-snapshot/1.0.0"
    },
    "source_mode": {
      "type": "string",
      "const": "live"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "request_started_at": {
      "type": "string",
      "minLength": 20
    },
    "decision_cutoff": {
      "type": "string",
      "minLength": 20
    },
    "portfolio_hash": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "source_access": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "provider",
          "client_version",
          "adapter_version",
          "status",
          "purpose",
          "terms_url",
          "checked_at",
          "free_features",
          "limitations",
          "domains",
          "request_budget"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "live-source-access/1.0.0"
          },
          "provider": {
            "type": "string",
            "enum": [
              "sec",
              "yahoo"
            ]
          },
          "client_version": {
            "type": "string",
            "minLength": 1
          },
          "adapter_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "AUTHORIZED",
              "PAUSED",
              "UNCONFIRMED"
            ]
          },
          "purpose": {
            "type": "string",
            "const": "personal-research"
          },
          "terms_url": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "minLength": 20
          },
          "free_features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "[a-z0-9-]+(?:\\.[a-z0-9-]+)+"
            }
          },
          "request_budget": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "evidence_id",
          "security_id",
          "semantic_field",
          "value",
          "unit",
          "currency",
          "source_id",
          "source_type",
          "source_locator",
          "source_version",
          "as_of",
          "published_at",
          "published_at_policy",
          "retrieved_at",
          "raw_content_hash",
          "kind",
          "usage",
          "metadata",
          "parent_ids",
          "parent_hashes"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "live-fact/1.0.0"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "security_id": {
            "type": "string",
            "minLength": 1
          },
          "semantic_field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "sec",
              "yahoo",
              "nasdaq",
              "bls",
              "treasury",
              "federal_reserve",
              "public_research",
              "issuer_research",
              "ownership",
              "options",
              "derived"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "as_of": {
            "type": "string",
            "minLength": 20
          },
          "published_at": {
            "type": "string",
            "minLength": 20
          },
          "published_at_policy": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 20
          },
          "raw_content_hash": {
            "type": "string",
            "pattern": "[a-f0-9]{64}"
          },
          "kind": {
            "type": "string",
            "enum": [
              "financial",
              "disclosure",
              "price",
              "macro",
              "research",
              "ownership",
              "market_structure",
              "derived"
            ]
          },
          "usage": {
            "type": "string",
            "enum": [
              "current",
              "comparison"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "parent_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parent_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "[a-f0-9]{64}"
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collection_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "raw_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "freshness_policy_version": {
      "type": "string",
      "const": "live-freshness/1.0.0"
    }
  }
}
