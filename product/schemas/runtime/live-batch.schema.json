{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "profile",
    "profile_hash",
    "portfolio_hash",
    "snapshot_hash",
    "decision_cutoff",
    "children"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "live-batch/1.0.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "const": "live-us-equity"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "portfolio_hash": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "decision_cutoff": {
      "type": "string",
      "minLength": 20
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "focus_security_id",
          "run_id",
          "status",
          "artifacts_hash"
        ],
        "properties": {
          "focus_security_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PASSED",
              "FAILED"
            ]
          },
          "artifacts_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
