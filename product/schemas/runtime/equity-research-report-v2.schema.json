{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equity-research-report/2.0.0",
  "title": "EquityResearchReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "invocation_id",
    "report_id",
    "status",
    "agent",
    "bindings",
    "security",
    "research_scope",
    "research_summary",
    "sections",
    "claims",
    "assumptions",
    "counter_evidence_refs",
    "invalidation_conditions",
    "reevaluation_triggers",
    "monitoring_indicators",
    "data_gaps",
    "confidence",
    "confidence_rationale",
    "skill_execution",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "equity-research-report/2.0.0"
    },
    "run_id": {
      "$ref": "equity-research-report.schema.json#/properties/run_id"
    },
    "invocation_id": {
      "$ref": "equity-research-report.schema.json#/properties/invocation_id"
    },
    "report_id": {
      "$ref": "equity-research-report.schema.json#/properties/report_id"
    },
    "status": {
      "$ref": "equity-research-report.schema.json#/properties/status"
    },
    "agent": {
      "$ref": "equity-research-report.schema.json#/properties/agent"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "security": {
      "$ref": "equity-research-report.schema.json#/properties/security"
    },
    "research_scope": {
      "const": "SINGLE_COMMON_STOCK"
    },
    "research_summary": {
      "$ref": "equity-research-report.schema.json#/properties/research_summary"
    },
    "sections": {
      "$ref": "equity-research-report.schema.json#/properties/sections"
    },
    "claims": {
      "$ref": "equity-research-report.schema.json#/properties/claims"
    },
    "assumptions": {
      "$ref": "equity-research-report.schema.json#/properties/assumptions"
    },
    "counter_evidence_refs": {
      "$ref": "equity-research-report.schema.json#/properties/counter_evidence_refs"
    },
    "invalidation_conditions": {
      "$ref": "equity-research-report.schema.json#/properties/invalidation_conditions"
    },
    "reevaluation_triggers": {
      "$ref": "equity-research-report.schema.json#/properties/reevaluation_triggers"
    },
    "monitoring_indicators": {
      "$ref": "equity-research-report.schema.json#/properties/monitoring_indicators"
    },
    "data_gaps": {
      "$ref": "equity-research-report.schema.json#/properties/data_gaps"
    },
    "confidence": {
      "$ref": "equity-research-report.schema.json#/properties/confidence"
    },
    "confidence_rationale": {
      "$ref": "equity-research-report.schema.json#/properties/confidence_rationale"
    },
    "skill_execution": {
      "$ref": "equity-research-report.schema.json#/properties/skill_execution"
    },
    "artifact_refs": {
      "$ref": "equity-research-report.schema.json#/properties/artifact_refs"
    }
  },
  "$defs": {
    "evidence_id": {
      "$ref": "equity-research-report.schema.json#/$defs/evidence_id"
    },
    "id": {
      "$ref": "equity-research-report.schema.json#/$defs/id"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "council_request_id",
        "council_request_hash",
        "holding_research_request_id",
        "holding_research_request_hash",
        "decision_cutoff",
        "input_kind",
        "input_request_id",
        "input_request_hash",
        "input_artifact_ref"
      ],
      "properties": {
        "council_request_id": {
          "type": "string",
          "minLength": 1
        },
        "council_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "holding_research_request_id": {
          "type": "string",
          "minLength": 1
        },
        "holding_research_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "input_kind": {
          "const": "SINGLE_STOCK_RESEARCH"
        },
        "input_request_id": {
          "type": "string",
          "minLength": 1
        },
        "input_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_artifact_ref": {
          "const": "audit/single-stock-request.json"
        }
      }
    },
    "security": {
      "$ref": "equity-research-report.schema.json#/$defs/security"
    },
    "summary": {
      "$ref": "equity-research-report.schema.json#/$defs/summary"
    },
    "section": {
      "$ref": "equity-research-report.schema.json#/$defs/section"
    },
    "sections": {
      "$ref": "equity-research-report.schema.json#/$defs/sections"
    },
    "claim": {
      "$ref": "equity-research-report.schema.json#/$defs/claim"
    },
    "assumption": {
      "$ref": "equity-research-report.schema.json#/$defs/assumption"
    },
    "condition": {
      "$ref": "equity-research-report.schema.json#/$defs/condition"
    },
    "trigger": {
      "$ref": "equity-research-report.schema.json#/$defs/trigger"
    },
    "indicator": {
      "$ref": "equity-research-report.schema.json#/$defs/indicator"
    },
    "gap": {
      "$ref": "equity-research-report.schema.json#/$defs/gap"
    },
    "skill": {
      "$ref": "equity-research-report.schema.json#/$defs/skill"
    }
  }
}
