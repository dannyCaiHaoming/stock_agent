{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/cio-decision-draft/2.0.0",
  "type": "object",
  "required": ["schema_version", "run_id", "invocation_id", "status", "agent", "consumed_reports", "action", "security_id", "current_weight", "target_weight_range", "maximum_notional", "time_horizon", "thesis", "counter_thesis", "consensus", "conflicts", "unresolved_questions", "invalidation_conditions", "confidence", "confidence_rationale", "evidence_refs", "no_trade_reason", "no_trade_explanation", "reevaluation_conditions", "skill_execution", "advisory_only"],
  "properties": {
    "schema_version": {"const": "cio-decision-draft/2.0.0"},
    "run_id": {"type": "string"},
    "invocation_id": {"type": "string"},
    "status": {"enum": ["COMPLETE", "INSUFFICIENT_EVIDENCE", "LOW_CONFIDENCE"]},
    "agent": {"const": "runtime_cio"},
    "consumed_reports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["agent", "output_hash"],
        "properties": {
          "agent": {"enum": ["runtime_company_analyst", "runtime_skeptic"]},
          "output_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "action": {"enum": ["BUY", "ADD", "HOLD", "TRIM", "EXIT", "NO_TRADE"]},
    "security_id": {"type": ["string", "null"]},
    "current_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "target_weight_range": {"type": ["array", "null"], "minItems": 2, "maxItems": 2},
    "maximum_notional": {"type": ["number", "null"], "minimum": 0},
    "time_horizon": {"type": "string", "minLength": 1},
    "thesis": {"type": "string"},
    "counter_thesis": {"type": "string"},
    "consensus": {"type": "array", "items": {"type": "string"}},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_key", "evidence_refs", "summary", "unresolved", "decision_impact", "confidence_impact"],
        "properties": {
          "conflict_key": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
          "summary": {"type": "string", "minLength": 1},
          "unresolved": {"const": true},
          "decision_impact": {"type": "string", "minLength": 1},
          "confidence_impact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "no_trade_reason": {"type": ["string", "null"]},
    "no_trade_explanation": {"type": ["string", "null"]},
    "reevaluation_conditions": {"type": "array", "items": {"type": "string"}},
    "skill_execution": {"type": "array", "minItems": 1},
    "advisory_only": {"const": true}
  },
  "additionalProperties": false
}
