{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-dimension-report/3.0.0",
  "title": "ResearchDimensionReportV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "run_id",
    "invocation_id",
    "capability",
    "scope",
    "security_ids",
    "status",
    "sufficiency",
    "evaluation_status",
    "bindings",
    "time_context",
    "execution",
    "summary",
    "claims",
    "assumptions",
    "calculations",
    "documents",
    "research_relationships",
    "limitations",
    "observation_conditions",
    "data_gaps",
    "artifact_refs",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "research-dimension-report/3.0.0"
    },
    "report_id": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/report_id"
    },
    "run_id": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/run_id"
    },
    "invocation_id": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/invocation_id"
    },
    "capability": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/capability"
    },
    "scope": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/scope"
    },
    "security_ids": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/security_ids"
    },
    "status": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/status"
    },
    "sufficiency": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/sufficiency"
    },
    "evaluation_status": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/evaluation_status"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "council_request_id",
        "council_request_hash",
        "decision_cutoff",
        "input_kind",
        "input_request_id",
        "input_request_hash",
        "input_artifact_ref"
      ],
      "properties": {
        "council_request_id": {
          "type": "string",
          "minLength": 1
        },
        "council_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "input_kind": {
          "const": "SINGLE_STOCK_RESEARCH"
        },
        "input_request_id": {
          "type": "string",
          "minLength": 1
        },
        "input_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_artifact_ref": {
          "const": "audit/single-stock-request.json"
        }
      }
    },
    "time_context": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/time_context"
    },
    "execution": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/execution"
    },
    "summary": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/summary"
    },
    "claims": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/claims"
    },
    "assumptions": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/assumptions"
    },
    "calculations": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/calculations"
    },
    "documents": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/documents"
    },
    "research_relationships": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/research_relationships"
    },
    "limitations": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/limitations"
    },
    "observation_conditions": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/observation_conditions"
    },
    "data_gaps": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/data_gaps"
    },
    "artifact_refs": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/artifact_refs"
    },
    "report_hash": {
      "$ref": "research-dimension-report-v2.schema.json#/properties/report_hash"
    }
  },
  "$defs": {
    "id": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/id"
    },
    "evidence_id": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/evidence_id"
    },
    "claim": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/claim"
    },
    "assumption": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/assumption"
    },
    "calculation": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/calculation"
    },
    "document": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/document"
    },
    "research_relationship": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/research_relationship"
    },
    "condition": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/condition"
    },
    "gap": {
      "$ref": "research-dimension-report-v2.schema.json#/$defs/gap"
    }
  }
}
