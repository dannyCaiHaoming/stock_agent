{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-capture-batch/1.1.0",
  "title": "ResearchCaptureBatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "security_id", "decision_cutoff", "created_at", "capabilities", "source_selections", "batch_hash"],
  "properties": {
    "schema_version": {"const": "research-capture-batch/1.1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "security_id": {"type": "string", "minLength": 1},
    "decision_cutoff": {"type": "string", "minLength": 20},
    "created_at": {"type": "string", "minLength": 20},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_selections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "batch_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
