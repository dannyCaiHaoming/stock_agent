{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peer-comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "target_security_id", "decision_cutoff", "candidate_count", "candidates", "target", "peers", "coverage_status", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "peer-comparison/1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1},
    "target_security_id": {"type": "string", "minLength": 1},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 5},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["security_id", "reason", "status", "evidence_refs"], "properties": {"security_id": {"type": "string"}, "reason": {"type": "string"}, "status": {"enum": ["INCLUDED", "EXCLUDED_NOT_COMPARABLE", "SOURCE_LIMITED"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "target": {"$ref": "#/$defs/company"},
    "peers": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/company"}},
    "coverage_status": {"enum": ["COMPLETE", "PARTIAL", "INSUFFICIENT_PEERS"]},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "company": {"type": "object", "additionalProperties": false, "required": ["security_id", "fiscal_period", "currency", "metrics", "comparability_notes"], "properties": {"security_id": {"type": "string"}, "fiscal_period": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"]}, "metrics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "metric_basis_id", "value", "unit", "basis", "status", "source_id", "as_of", "retrieved_at", "published_at", "period", "evidence_refs", "formula", "calculation_ref", "calculation"], "properties": {"name": {"type": "string"}, "metric_basis_id": {"type": "string", "minLength": 1}, "value": {"type": ["string", "null"]}, "unit": {"type": "string", "minLength": 1}, "basis": {"type": ["string", "null"]}, "status": {"enum": ["COMPARABLE", "LIMITED_COMPARABILITY", "NOT_COMPARABLE", "INPUT_MISSING"]}, "source_id": {"type": "string", "minLength": 1}, "as_of": {"type": "string", "format": "date-time"}, "retrieved_at": {"type": "string", "format": "date-time"}, "published_at": {"type": ["string", "null"], "format": "date-time"}, "period": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "formula": {"type": ["string", "null"]}, "calculation_ref": {"type": ["string", "null"]}, "calculation": {"type": ["object", "null"]}}}}, "comparability_notes": {"type": "array", "items": {"type": "string"}}}}
  }
}
