{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-research-bundle/3.0.0",
  "title": "HoldingResearchBundleV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "run_id",
    "bindings",
    "decision_cutoff",
    "common_stock_security_ids",
    "report_refs",
    "coverage",
    "consumability",
    "package_provenance",
    "unresolved_cross_dimension_questions",
    "no_unresolved_reason",
    "summary",
    "artifact_refs",
    "bundle_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "holding-research-bundle/3.0.0"
    },
    "bundle_id": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/bundle_id"
    },
    "run_id": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/run_id"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "council_request_id",
        "council_request_hash",
        "input_kind",
        "input_request_id",
        "input_request_hash",
        "input_artifact_ref"
      ],
      "properties": {
        "council_request_id": {
          "type": "string",
          "minLength": 1
        },
        "council_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_kind": {
          "const": "SINGLE_STOCK_RESEARCH"
        },
        "input_request_id": {
          "type": "string",
          "minLength": 1
        },
        "input_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_artifact_ref": {
          "const": "audit/single-stock-request.json"
        }
      }
    },
    "decision_cutoff": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/decision_cutoff"
    },
    "common_stock_security_ids": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/common_stock_security_ids"
    },
    "report_refs": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/report_refs"
    },
    "coverage": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/coverage"
    },
    "consumability": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/consumability"
    },
    "package_provenance": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/package_provenance"
    },
    "unresolved_cross_dimension_questions": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/unresolved_cross_dimension_questions"
    },
    "no_unresolved_reason": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/no_unresolved_reason"
    },
    "summary": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/summary"
    },
    "artifact_refs": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/artifact_refs"
    },
    "bundle_hash": {
      "$ref": "holding-research-bundle-v2.schema.json#/properties/bundle_hash"
    }
  }
}
