{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/counter-thesis-report/2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "invocation_id", "status", "agent", "mode", "scope", "challenges", "assumptions", "evidence_refs", "counter_evidence_refs", "uncertainties", "data_gaps", "invalidation_conditions", "confidence", "confidence_rationale", "skill_execution", "artifact_refs"],
  "properties": {
    "schema_version": {"const": "counter-thesis-report/2.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "TIMEOUT", "INSUFFICIENT_EVIDENCE", "LOW_CONFIDENCE"]},
    "agent": {"const": "runtime_skeptic"},
    "mode": {"const": "INDEPENDENT_FIRST_PASS"},
    "scope": {"type": "string", "minLength": 1},
    "challenges": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["challenge_id", "statement", "evidence_refs", "assumption_ids", "resolution_evidence_needed"],
        "properties": {
          "challenge_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "resolution_evidence_needed": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assumption_id", "statement"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "counter_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_rationale": {"type": "string", "minLength": 1},
    "skill_execution": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/skill"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_name", "version", "invocation_hash"],
      "properties": {
        "skill_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "invocation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
