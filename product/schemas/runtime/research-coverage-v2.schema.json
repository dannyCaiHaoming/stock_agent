{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-coverage/2.0.0",
  "title": "ResearchCoverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "council_request_id",
    "council_request_hash",
    "stage_status",
    "execution_mode",
    "target_concurrency",
    "effective_concurrency",
    "execution_mode_reason",
    "per_item_timeout_seconds",
    "batch_budget_seconds",
    "batch_started_at",
    "cancelled_at",
    "items",
    "coverage_hash",
    "input_kind",
    "input_request_id",
    "input_request_hash",
    "input_artifact_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "research-coverage/2.0.0"
    },
    "batch_id": {
      "$ref": "research-coverage.schema.json#/properties/batch_id"
    },
    "council_request_id": {
      "$ref": "research-coverage.schema.json#/properties/council_request_id"
    },
    "council_request_hash": {
      "$ref": "research-coverage.schema.json#/properties/council_request_hash"
    },
    "stage_status": {
      "$ref": "research-coverage.schema.json#/properties/stage_status"
    },
    "execution_mode": {
      "$ref": "research-coverage.schema.json#/properties/execution_mode"
    },
    "target_concurrency": {
      "$ref": "research-coverage.schema.json#/properties/target_concurrency"
    },
    "effective_concurrency": {
      "$ref": "research-coverage.schema.json#/properties/effective_concurrency"
    },
    "execution_mode_reason": {
      "$ref": "research-coverage.schema.json#/properties/execution_mode_reason"
    },
    "per_item_timeout_seconds": {
      "$ref": "research-coverage.schema.json#/properties/per_item_timeout_seconds"
    },
    "batch_budget_seconds": {
      "$ref": "research-coverage.schema.json#/properties/batch_budget_seconds"
    },
    "batch_started_at": {
      "$ref": "research-coverage.schema.json#/properties/batch_started_at"
    },
    "cancelled_at": {
      "$ref": "research-coverage.schema.json#/properties/cancelled_at"
    },
    "items": {
      "$ref": "research-coverage.schema.json#/properties/items"
    },
    "coverage_hash": {
      "$ref": "research-coverage.schema.json#/properties/coverage_hash"
    },
    "input_kind": {
      "const": "SINGLE_STOCK_RESEARCH"
    },
    "input_request_id": {
      "type": "string",
      "minLength": 1
    },
    "input_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_artifact_ref": {
      "const": "audit/single-stock-request.json"
    }
  }
}
