{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common-stock collection portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purpose", "base_currency", "source_id", "as_of",
    "retrieved_at", "positions"
  ],
  "properties": {
    "schema_version": {"const": "live-portfolio/2.0.0"},
    "purpose": {"const": "COMMON_STOCK_DATA_COLLECTION"},
    "base_currency": {"const": "USD"},
    "source_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 20},
    "retrieved_at": {"type": "string", "minLength": 20},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security_id", "ticker", "exchange", "share_class"],
        "properties": {
          "security_id": {"type": "string", "minLength": 1},
          "ticker": {"type": "string", "pattern": "[A-Z][A-Z0-9.-]{0,14}"},
          "exchange": {"type": ["string", "null"], "enum": ["XNYS", "XNAS", "XASE", null]},
          "share_class": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
