{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live source-access",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "client_version",
    "adapter_version",
    "purpose",
    "terms_url",
    "checked_at",
    "free_features",
    "limitations",
    "domains",
    "request_budget",
    "data_role",
    "operator_approval",
    "upstream_permission"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "live-source-access/4.0.0"
    },
    "provider": {
      "type": "string",
      "enum": [
        "nasdaq",
        "yahoo",
        "eastmoney",
        "sec"
      ]
    },
    "client_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "const": "personal-research"
    },
    "terms_url": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "minLength": 20
    },
    "free_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "[a-z0-9-]+(?:\\.[a-z0-9-]+)+"
      }
    },
    "request_budget": {
      "type": "integer",
      "minimum": 1
    },
    "data_role": {
      "type": "string",
      "enum": [
        "universe",
        "primary_market",
        "backup_market",
        "disclosure"
      ]
    },
    "operator_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "record",
        "record_hash"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "PAUSED",
            "NOT_APPROVED"
          ]
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_id",
            "approved_at",
            "scope",
            "statement",
            "basis"
          ],
          "properties": {
            "approval_id": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "minLength": 20
            },
            "scope": {
              "type": "object",
              "const": {
                "purpose": "personal-research",
                "change": "us-equity-live-advisory-slice",
                "position_policy": "ALL_CONFIRMED_COMMON_STOCKS_RESOURCE_BOUNDED",
                "providers": [
                  "nasdaq",
                  "yahoo",
                  "eastmoney",
                  "sec"
                ],
                "advisory_only": true
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "record_hash": {
          "type": "string",
          "pattern": "[a-f0-9]{64}"
        }
      }
    },
    "upstream_permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "basis",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNVERIFIED",
            "VERIFIED",
            "DENIED"
          ]
        },
        "checked_at": {
          "type": "string",
          "minLength": 20
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
