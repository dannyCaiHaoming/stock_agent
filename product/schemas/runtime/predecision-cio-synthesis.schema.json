{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predecision-cio-synthesis/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "invocation_id", "source_run_id", "source_package_hash", "target_security_id", "requested_level", "actual_level", "decision_cutoff", "generated_at", "status", "advisory_only", "complete_portfolio_decision", "risk_status", "consumed_reports", "analysis_horizon", "judgment", "reasoning", "thesis", "counter_thesis", "consensus", "conflicts", "business_outlook", "price_attractiveness", "account_fit", "key_facts", "challenge_dispositions", "macro_market_transmission", "unresolved_questions", "invalidation_conditions", "reevaluation_conditions", "watch_plan", "confidence_rationale", "limitations", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "predecision-cio-synthesis/1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_security_id": {"const": "US:COMMON_STOCK:MRVL"},
    "requested_level": {"const": "RESEARCH_SYNTHESIS"},
    "actual_level": {"const": "RESEARCH_SYNTHESIS"},
    "decision_cutoff": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "LOW_CONFIDENCE"]},
    "advisory_only": {"const": true},
    "complete_portfolio_decision": {"const": false},
    "risk_status": {"const": "NOT_RUN"},
    "consumed_reports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["report_id", "role", "security_ids", "invocation_id", "content_hash"], "properties": {"report_id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "security_ids": {"type": "array", "items": {"type": "string"}}, "invocation_id": {"type": ["string", "null"]}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "analysis_horizon": {"type": "string", "minLength": 1},
    "judgment": {"type": "string", "minLength": 1},
    "reasoning": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "counter_thesis": {"type": "string", "minLength": 1},
    "consensus": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "business_outlook": {"type": "string", "minLength": 1},
    "price_attractiveness": {"type": "string", "minLength": 1},
    "account_fit": {"const": "当前账户适配未评估"},
    "key_facts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fact", "report_ids", "evidence_refs", "reasoning"], "properties": {"fact": {"type": "string", "minLength": 1}, "report_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "reasoning": {"type": "string", "minLength": 1}}}},
    "challenge_dispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["report_id", "challenge_id", "disposition", "rationale", "judgment_impact", "reevaluate_when"], "properties": {"report_id": {"type": "string"}, "challenge_id": {"type": "string"}, "disposition": {"enum": ["ACCEPT", "PARTIALLY_ACCEPT", "REJECT", "UNRESOLVED"]}, "rationale": {"type": "string", "minLength": 1}, "judgment_impact": {"type": "string", "minLength": 1}, "reevaluate_when": {"type": "string", "minLength": 1}}}},
    "macro_market_transmission": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["channel", "report_ids", "mechanism", "assessment", "limitations"], "properties": {"channel": {"type": "string", "minLength": 1}, "report_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "mechanism": {"type": "string", "minLength": 1}, "assessment": {"type": "string", "minLength": 1}, "limitations": {"type": "string", "minLength": 1}}}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reevaluation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "watch_plan": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["item", "trigger", "reassess_on"], "properties": {"item": {"type": "string", "minLength": 1}, "trigger": {"type": "string", "minLength": 1}, "reassess_on": {"type": "string", "minLength": 1}}}},
    "confidence_rationale": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
