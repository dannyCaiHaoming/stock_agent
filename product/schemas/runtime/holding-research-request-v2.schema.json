{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holding-research-request/2.0.0",
  "title": "HoldingResearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "invocation_id",
    "council_request_id",
    "council_request_hash",
    "security",
    "research_question",
    "holding_horizon",
    "decision_cutoff",
    "allowed_evidence_ids",
    "evidence_bundle_hash",
    "data_gaps",
    "user_context",
    "agent_binding",
    "skill_bindings",
    "request_hash",
    "input_kind",
    "input_request_id",
    "input_request_hash",
    "input_artifact_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "holding-research-request/2.0.0"
    },
    "request_id": {
      "$ref": "holding-research-request.schema.json#/properties/request_id"
    },
    "run_id": {
      "$ref": "holding-research-request.schema.json#/properties/run_id"
    },
    "invocation_id": {
      "$ref": "holding-research-request.schema.json#/properties/invocation_id"
    },
    "council_request_id": {
      "$ref": "holding-research-request.schema.json#/properties/council_request_id"
    },
    "council_request_hash": {
      "$ref": "holding-research-request.schema.json#/properties/council_request_hash"
    },
    "security": {
      "$ref": "holding-research-request.schema.json#/properties/security"
    },
    "research_question": {
      "$ref": "holding-research-request.schema.json#/properties/research_question"
    },
    "holding_horizon": {
      "$ref": "holding-research-request.schema.json#/properties/holding_horizon"
    },
    "decision_cutoff": {
      "$ref": "holding-research-request.schema.json#/properties/decision_cutoff"
    },
    "allowed_evidence_ids": {
      "$ref": "holding-research-request.schema.json#/properties/allowed_evidence_ids"
    },
    "evidence_bundle_hash": {
      "$ref": "holding-research-request.schema.json#/properties/evidence_bundle_hash"
    },
    "data_gaps": {
      "$ref": "holding-research-request.schema.json#/properties/data_gaps"
    },
    "user_context": {
      "$ref": "holding-research-request.schema.json#/properties/user_context"
    },
    "agent_binding": {
      "$ref": "holding-research-request.schema.json#/properties/agent_binding"
    },
    "skill_bindings": {
      "$ref": "holding-research-request.schema.json#/properties/skill_bindings"
    },
    "request_hash": {
      "$ref": "holding-research-request.schema.json#/properties/request_hash"
    },
    "input_kind": {
      "const": "SINGLE_STOCK_RESEARCH"
    },
    "input_request_id": {
      "type": "string",
      "minLength": 1
    },
    "input_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_artifact_ref": {
      "const": "audit/single-stock-request.json"
    }
  }
}
