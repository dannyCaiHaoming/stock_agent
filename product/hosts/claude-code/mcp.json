      "command": "{{PYTHON}}",
      "args": ["-B", "-m", "product.mcp.research", "--connection-env-prefix", "STOCK_AGENT_COMPANY"],
      "env": {"PYTHONPATH": "{{REPOSITORY_ROOT}}", "STOCK_AGENT_COMPANY_CONNECTION": "${STOCK_AGENT_COMPANY_CONNECTION}", "STOCK_AGENT_COMPANY_TOKEN": "${STOCK_AGENT_COMPANY_TOKEN}"}
    },
    "market": {
