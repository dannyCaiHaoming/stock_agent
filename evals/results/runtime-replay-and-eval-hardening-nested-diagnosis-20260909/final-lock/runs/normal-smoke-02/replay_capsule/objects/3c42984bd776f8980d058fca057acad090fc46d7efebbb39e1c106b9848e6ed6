{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/deterministic-test-execution/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "runner", "command", "cwd", "tmpdir", "started_at", "completed_at", "process_id", "exit_code", "tests_run", "assertion_failures", "test_errors", "environment_errors", "environment_probe", "stdout", "stderr", "event_hash"],
  "properties": {
    "schema_version": {"const": "deterministic-test-execution/1.0.0"},
    "event_id": {"type": "string", "minLength": 1},
    "runner": {"const": "python-unittest-subprocess/1.0.0"},
    "command": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "tmpdir": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 1},
    "exit_code": {"type": "integer"},
    "tests_run": {"type": "integer", "minimum": 0},
    "assertion_failures": {"type": "integer", "minimum": 0},
    "test_errors": {"type": "integer", "minimum": 0},
    "environment_errors": {"type": "integer", "minimum": 0},
    "environment_probe": {"enum": ["PASS", "FAIL"]},
    "stdout": {"$ref": "#/$defs/transcript"},
    "stderr": {"$ref": "#/$defs/transcript"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
