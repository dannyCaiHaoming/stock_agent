{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/semantic-rubric-result/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "eval_id", "grader", "dimensions", "output_hash"],
  "properties": {
    "schema_version": {"const": "semantic-rubric-result/1.0.0"},
    "eval_id": {"type": "string", "minLength": 1},
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "model", "prompt_hash", "rubric_hash", "input_hash"],
      "properties": {
        "agent": {"const": "dev_eval"},
        "model": {"type": "string", "minLength": 1},
        "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rubric_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_trade_reasoning", "analyst_thesis_grounding", "skeptic_counter_evidence", "cio_conflict_handling", "confidence_calibration"],
      "properties": {
        "no_trade_reasoning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "grade", "evidence_refs", "rationale"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
            "grade": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "analyst_thesis_grounding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "grade", "evidence_refs", "rationale"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
            "grade": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "skeptic_counter_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "grade", "evidence_refs", "rationale"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
            "grade": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "cio_conflict_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "grade", "evidence_refs", "rationale"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
            "grade": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "confidence_calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "grade", "evidence_refs", "rationale"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
            "grade": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
