            },
            "grade": {
              "maximum": 3,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "rationale": {
              "minLength": 1,
              "type": "string"
            },
            "status": {
              "enum": [
                "PASS",
