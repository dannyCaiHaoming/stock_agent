                "NOT_APPLICABLE"
              ]
            }
          },
          "required": [
            "status",
            "grade",
            "evidence_refs",
            "rationale"
          ],
          "type": "object"
        },
        "no_trade_reasoning": {
          "additionalProperties": false,
