{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/regression-case/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "fixture", "data_version", "llm_required", "topologies", "injection", "expected_invariants"],
  "properties": {
    "schema_version": {"const": "regression-case/1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "minLength": 1},
    "data_version": {"type": "string", "minLength": 1},
    "llm_required": {"type": "boolean"},
    "topologies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["product-council", "cio-only", "analyst-cio", "full-council"]}},
    "injection": {"type": ["string", "null"]},
    "expected_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value", "hard"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "value": {},
          "hard": {"type": "boolean"}
        }
      }
    }
  }
}
