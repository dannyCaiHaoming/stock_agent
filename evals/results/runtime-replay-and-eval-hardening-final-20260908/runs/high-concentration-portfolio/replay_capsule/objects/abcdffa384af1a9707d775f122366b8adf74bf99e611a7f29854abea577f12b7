{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/promotion-input/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "candidate_version", "baseline_version", "candidate_changes_default_topology", "artifacts"],
  "properties": {
    "schema_version": {"const": "promotion-input/1.0.0"},
    "gate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "minLength": 1},
    "candidate_changes_default_topology": {"type": "boolean"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_manifest", "baseline_manifest", "model_policy", "deterministic_tests", "semantic_calibration", "regression", "execution_replay", "runtime_evals", "grader_proofs", "baseline_runtime_evals", "ablation", "baseline_ablation", "trace_integrity"],
      "properties": {
        "candidate_manifest": {"type": "object"},
        "baseline_manifest": {"type": "object"},
        "model_policy": {"type": "object"},
        "deterministic_tests": {"type": "object"},
        "semantic_calibration": {"type": "object"},
        "regression": {"type": "object"},
        "execution_replay": {"type": "object"},
        "runtime_evals": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "grader_proofs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "baseline_runtime_evals": {"type": "array", "items": {"type": "object"}},
        "ablation": {"type": "object"},
        "baseline_ablation": {"type": ["object", "null"]},
        "trace_integrity": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    }
  }
}
