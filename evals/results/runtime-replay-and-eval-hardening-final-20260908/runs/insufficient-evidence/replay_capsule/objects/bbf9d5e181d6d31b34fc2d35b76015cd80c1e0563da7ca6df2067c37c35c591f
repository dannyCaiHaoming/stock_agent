{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/runtime-fixture/2.0.0",
  "type": "object",
  "required": ["fixture_version", "fixture_id", "scenario_type", "decision_cutoff", "freshness_policy", "conflict_policy_version", "portfolio", "evidence"],
  "properties": {
    "fixture_version": {"const": "2.0.0"},
    "fixture_id": {"type": "string", "minLength": 1},
    "scenario_type": {"enum": ["normal", "future_or_stale", "evidence_conflict", "risk_veto"]},
    "decision_cutoff": {"type": "string", "format": "date-time"},
    "freshness_policy": {
      "type": "object",
      "required": ["version", "default_max_age_days", "field_max_age_days"]
    },
    "conflict_policy_version": {"type": "string", "minLength": 1},
    "boundary_draft_fixture": {"type": "string", "minLength": 1},
    "portfolio": {"type": "object", "required": ["base_currency", "cash", "positions", "mandate"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "security_id", "semantic_field", "value", "unit", "source_id", "source_type", "source_locator", "source_version", "as_of", "retrieved_at"]
      }
    }
  },
  "additionalProperties": false
}
