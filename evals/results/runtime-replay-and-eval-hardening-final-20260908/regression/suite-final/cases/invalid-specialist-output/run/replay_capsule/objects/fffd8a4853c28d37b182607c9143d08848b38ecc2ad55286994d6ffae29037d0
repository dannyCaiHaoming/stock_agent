{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/replay-capsule/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "locked_context", "objects", "root_hash", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "replay-capsule/1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "locked_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_version", "model", "codex_runtime", "python_runtime", "runtime_profile", "run_mode", "ablation_profile", "trigger_reason", "research_question", "decision_cutoff", "fixture_hash", "gate_hash", "version_manifest_hash", "product_integrity_hash"],
      "properties": {
        "candidate_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "codex_runtime": {"type": "string", "minLength": 1},
        "python_runtime": {"type": "string", "minLength": 1},
        "runtime_profile": {"type": "string", "minLength": 1},
        "run_mode": {"type": "string", "enum": ["PRODUCT_COUNCIL", "EVAL_ABLATION", "EXECUTION_REPLAY"]},
        "ablation_profile": {"type": ["string", "null"]},
        "trigger_reason": {"type": "string", "minLength": 1},
        "research_question": {"type": "string", "minLength": 1},
        "decision_cutoff": {"type": "string", "minLength": 1},
        "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "product_integrity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_path", "sha256", "bytes", "media_type", "role", "executable"],
        "properties": {
          "logical_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "executable": {"type": "boolean"}
        }
      }
    },
    "root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
