{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/version-manifest/3.0.0",
  "title": "Portfolio Council Version Manifest",
  "type": "object",
  "required": ["manifest_version", "candidate_version", "codex_runtime", "model", "runtime_profile", "decision_contract", "resource_hashes", "skills", "agents", "schemas", "mcp_adapters", "risk_policy", "data_snapshot", "assurance", "assurance_hashes"],
  "properties": {
    "manifest_version": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "codex_runtime": {"type": "string", "pattern": "^codex-cli/"},
    "model": {"type": "string", "minLength": 1, "not": {"pattern": "(fixture-model|Fixture-Model|placeholder|Placeholder|unknown|Unknown|mock|Mock)"}},
    "runtime_profile": {"type": "string", "minLength": 1},
    "decision_contract": {"const": "council-decision-contract/1.0.0"},
    "resource_hashes": {
      "type": "object",
      "required": ["plugin", "plugin_mcp", "runtime_config", "runtime_profile", "decision_contract", "council_skill", "cio_agent", "company_agent", "skeptic_agent"],
      "additionalProperties": false,
      "properties": {
        "plugin": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plugin_mcp": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_config": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_profile": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_contract": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "council_skill": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cio_agent": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "company_agent": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "skeptic_agent": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "skills": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "agents": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "schemas": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "mcp_adapters": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "risk_policy": {"type": "string", "minLength": 1},
    "data_snapshot": {"type": "string", "minLength": 1}
    ,
    "assurance": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "assurance_hashes": {
      "type": "object",
      "required": ["model_routing_policy", "runtime_eval_rubric", "runtime_eval_grader_skill", "runtime_eval_grader_agent", "runtime_eval_calibration", "regression_set", "ablation_profiles", "promotion_policy"],
      "additionalProperties": false,
      "properties": {
        "model_routing_policy": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_eval_rubric": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_eval_grader_skill": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_eval_grader_agent": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_eval_calibration": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "regression_set": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ablation_profiles": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "promotion_policy": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": false
}
