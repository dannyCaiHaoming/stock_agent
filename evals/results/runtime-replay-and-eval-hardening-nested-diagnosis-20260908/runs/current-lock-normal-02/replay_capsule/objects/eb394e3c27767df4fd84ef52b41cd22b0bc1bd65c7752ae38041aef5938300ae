{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/invocation-manifest/2.1.0",
  "title": "Agent 调用清单",
  "type": "object",
  "required": ["schema_version", "run_id", "invocation_id", "agent", "skills", "skill_execution", "task_prompt_hash", "task_prompt_artifact", "instruction_bundle_hash", "model", "codex_runtime", "evidence_ids", "tool_permissions", "input_artifact", "input_hash", "output_schema", "output_schema_hash", "decision_contract", "manifest_hash"],
  "properties": {
    "schema_version": {"const": "invocation-manifest/2.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "pattern": "^inv_[a-f0-9]{24}$"},
    "agent": {"$ref": "#/$defs/versioned_resource"},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/versioned_resource"}, "minItems": 1},
    "skill_execution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_name", "version", "invocation_hash"],
        "properties": {
          "skill_name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "invocation_hash": {"$ref": "#/$defs/hash"}
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "task_prompt_hash": {"$ref": "#/$defs/hash"},
    "task_prompt_artifact": {"type": "string", "minLength": 1},
    "instruction_bundle_hash": {"$ref": "#/$defs/hash"},
    "model": {"type": "string", "minLength": 1},
    "codex_runtime": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tool_permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "input_artifact": {"type": "string", "minLength": 1},
    "input_hash": {"$ref": "#/$defs/hash"},
    "output_schema": {"type": "string", "minLength": 1},
    "output_schema_hash": {"$ref": "#/$defs/hash"},
    "decision_contract": {"$ref": "#/$defs/decision_contract"},
    "manifest_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "versioned_resource": {
      "type": "object",
      "required": ["name", "version", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "decision_contract": {
      "type": "object",
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {"const": "council-decision-contract/1.0.0"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
