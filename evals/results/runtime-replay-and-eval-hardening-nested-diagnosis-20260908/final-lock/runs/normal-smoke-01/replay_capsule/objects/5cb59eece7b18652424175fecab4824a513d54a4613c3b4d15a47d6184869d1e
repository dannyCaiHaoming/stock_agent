{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/promotion-gate/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "candidate_version", "baseline_version", "status", "hard_gates", "soft_metrics", "reason_codes", "prior_result", "input_hashes", "result_hash"],
  "properties": {
    "schema_version": {"const": "promotion-gate/1.0.0"},
    "gate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "hard_gates": {"type": "object"},
    "soft_metrics": {"type": "object"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "prior_result": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate_id", "path", "sha256"],
          "properties": {
            "gate_id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "input_hashes": {"type": "object"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
