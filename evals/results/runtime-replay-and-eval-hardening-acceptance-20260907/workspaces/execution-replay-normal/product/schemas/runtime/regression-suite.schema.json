{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/regression-suite/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "candidate_hash", "set_hash", "case_results", "status", "reason_codes", "suite_hash"],
  "properties": {
    "schema_version": {"const": "regression-suite/1.0.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "suite_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
