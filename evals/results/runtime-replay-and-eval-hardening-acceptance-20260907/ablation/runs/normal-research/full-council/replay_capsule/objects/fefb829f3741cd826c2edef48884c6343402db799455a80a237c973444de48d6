{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-council/agent-research-report/2.0.0",
  "type": "object",
  "required": ["schema_version", "run_id", "invocation_id", "status", "agent", "scope", "claims", "assumptions", "counter_evidence_refs", "uncertainties", "data_gaps", "invalidation_conditions", "confidence", "confidence_rationale", "skill_execution", "artifact_refs"],
  "properties": {
    "schema_version": {"const": "agent-research-report/2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE", "TIMEOUT", "INSUFFICIENT_EVIDENCE", "LOW_CONFIDENCE"]},
    "agent": {"const": "runtime_company_analyst"},
    "scope": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "counter_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_rationale": {"type": "string", "minLength": 1},
    "skill_execution": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/skill"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "statement", "kind", "evidence_refs", "assumption_ids"],
      "properties": {
        "claim_id": {"type": "string"},
        "statement": {"type": "string"},
        "kind": {"enum": ["FACT", "INTERPRETATION"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "assumption_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["assumption_id", "statement", "rationale"],
      "properties": {
        "assumption_id": {"type": "string"},
        "statement": {"type": "string"},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": ["skill_name", "version", "invocation_hash"],
      "properties": {
        "skill_name": {"type": "string"},
        "version": {"type": "string"},
        "invocation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
