"""Stable machine-readable reason codes shared by runtime assurance flows."""

from __future__ import annotations

from enum import StrEnum


class AssuranceReason(StrEnum):
    SCHEMA_INVALID = "SCHEMA_INVALID"
    ARTIFACT_MISSING = "ARTIFACT_MISSING"
    ARTIFACT_HASH_MISMATCH = "ARTIFACT_HASH_MISMATCH"
    VERSION_LOCK_MISSING = "VERSION_LOCK_MISSING"
    VERSION_DRIFT = "VERSION_DRIFT"
    EVIDENCE_CLOSURE_FAILED = "EVIDENCE_CLOSURE_FAILED"
    PIT_LEAKAGE = "PIT_LEAKAGE"
    TRACE_INCOMPLETE = "TRACE_INCOMPLETE"
    RISK_BYPASS = "RISK_BYPASS"
    REQUIRED_NO_TRADE_MISSING = "REQUIRED_NO_TRADE_MISSING"
    CAPSULE_MISSING = "CAPSULE_MISSING"
    CAPSULE_OBJECT_MISSING = "CAPSULE_OBJECT_MISSING"
    CAPSULE_HASH_MISMATCH = "CAPSULE_HASH_MISMATCH"
    CAPSULE_PATH_FORBIDDEN = "CAPSULE_PATH_FORBIDDEN"
    CAPSULE_SENSITIVE_CONTENT = "CAPSULE_SENSITIVE_CONTENT"
    EXECUTION_REPLAY_UNSUPPORTED = "EXECUTION_REPLAY_UNSUPPORTED"
    EXECUTION_REPLAY_NOT_COMPARABLE = "EXECUTION_REPLAY_NOT_COMPARABLE"
    STATIC_CANDIDATE_FORBIDDEN = "STATIC_CANDIDATE_FORBIDDEN"
    MISSING_TELEMETRY = "MISSING_TELEMETRY"
    MODEL_ROUTE_INVALID = "MODEL_ROUTE_INVALID"
    ASTRA_APPROVAL_MISSING = "ASTRA_APPROVAL_MISSING"
    LLM_CALL_FORBIDDEN = "LLM_CALL_FORBIDDEN"
    ABLATION_NOT_COMPARABLE = "ABLATION_NOT_COMPARABLE"
    ABLATION_PROFILE_NOT_PUBLISHABLE = "ABLATION_PROFILE_NOT_PUBLISHABLE"
    NO_MEASURABLE_GAIN = "NO_MEASURABLE_GAIN"
    PROMOTION_INPUT_INVALID = "PROMOTION_INPUT_INVALID"


def code_from_error(error: BaseException | str) -> str:
    """Return a stable leading code from an exception message."""

    message = str(error)
    candidate = message.split(":", 1)[0]
    return candidate if candidate else AssuranceReason.SCHEMA_INVALID.value
