          "required": ["status", "agent", "claims", "counter_evidence_refs", "data_gaps", "invalidation_conditions", "confidence_rationale", "skill_execution"]
        },
        "eval": {
          "fixtures": ["fixtures/success.json", "fixtures/missing_evidence.json", "fixtures/low_confidence.json"],
          "acceptance": ["real_agent_event", "skill_execution_proof", "evidence_closure", "no_portfolio_action"]
