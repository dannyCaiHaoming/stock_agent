        },
        "tool_data": {
          "read_only_tools": ["fixture_evidence.query"],
          "forbidden": ["raw_fixture", "web", "external_provider", "broker", "account_write"]
        },
        "skill_reasoning": {
          "skills": ["evidence-grounding", "counter-thesis"],
          "responsibilities": ["independent_disconfirmation", "alternative_explanations", "failure_paths", "evidence_gaps"]
