        "structured_output": {
          "artifact": "CounterThesisReport/2.0.0",
          "required": ["status", "agent", "mode", "challenges", "evidence_refs", "data_gaps", "invalidation_conditions", "confidence_rationale", "skill_execution"]
        },
        "eval": {
          "fixtures": ["fixtures/success.json", "fixtures/failure.json", "fixtures/missing_evidence.json"],
          "acceptance": ["independent_session", "first_pass_context_isolation", "non_duplicate_challenge_or_gap", "evidence_closure", "no_portfolio_action"]
